# PROPOSAL, not applied. Paths are under ~/docker/compose_includes/github-runners. Tags are examples: use what build.sh prints.
# Both guards: the image, and RUNNER_TOOL_CACHE pointing at the toolcache baked into the image. The per-slot
# /opt/hostedtoolcache bind is dropped (it would only hide nothing now, and a persistent toolcache is what the image replaces),
# and so is its cache_dirs entry. Verify with ./autoscale.sh check before restarting any guard.
--- a/guard-lite.yaml
+++ b/guard-lite.yaml
@@ cache_dirs:
-  - ${USERDIR}/runner-scaling/lite-{slot}/toolcache
   - ${USERDIR}/runner-scaling/lite-{slot}/cache
@@ runner:
-  image: myoung34/github-runner:ubuntu-noble@sha256:46c0ed292169f619594248cbfa6752d2c5760e170165bb401a2d132f71a2faf7 # pinned; bump deliberately
+  image: runner-ci:lite-20261119-617562fe # built by runner-scaling/images/build.sh; bump deliberately
@@ env:
-    RUNNER_TOOL_CACHE: /opt/hostedtoolcache
+    RUNNER_TOOL_CACHE: /opt/ci/toolcache # baked into the image: setup-go and setup-node find Go and Node there
@@ binds:
-    - ${USERDIR}/runner-scaling/lite-{slot}/toolcache:/opt/hostedtoolcache
     - ${USERDIR}/runner-scaling/lite-{slot}/cache:/cache
--- a/guard-sysbox.yaml
+++ b/guard-sysbox.yaml
@@ cache_dirs:
-  - ${USERDIR}/runner-scaling/sbx-{slot}/toolcache
   - ${USERDIR}/runner-scaling/sbx-{slot}/cache
@@ runner:
-  image: myoung34/github-runner:ubuntu-noble@sha256:46c0ed292169f619594248cbfa6752d2c5760e170165bb401a2d132f71a2faf7 # pinned; bump deliberately
+  image: runner-ci:sysbox-20261119-617562fe # built by runner-scaling/images/build.sh; bump deliberately
@@ env:
-    RUNNER_TOOL_CACHE: /opt/hostedtoolcache
+    RUNNER_TOOL_CACHE: /opt/ci/toolcache
@@ binds:
-    - ${USERDIR}/runner-scaling/sbx-{slot}/toolcache:/opt/hostedtoolcache
