# Copy to .env next to compose.lite.yaml. These are identifiers, not secrets; the private key is a file (secrets/github_app.pem).
# Client ID: the GitHub App's settings page, "Client ID" (starts with Iv).
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# Installation ID: Organization settings > Installed GitHub Apps > Configure: the number at the end of the URL
# (.../settings/installations/<this number>).
GITHUB_APP_INSTALLATION_ID=12345678
